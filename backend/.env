PORT=5000
MONGODB_URI=mongodb://localhost:27017/roomhub
NODE_ENV=development

# JWT Configuration
JWT_SECRET=super_secret_access_token_key_12345
JWT_REFRESH_SECRET=super_secret_refresh_token_key_67890
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (Nodemailer mock or Ethereal/Resend)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=585
EMAIL_USER=mock_user@ethereal.email
EMAIL_PASS=mock_pass_123
EMAIL_FROM=RoomHub <noreply@roomhub.vn>

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=roomhub_cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=abcdefg_secret

# CORS
CLIENT_URL=http://localhost:8081
